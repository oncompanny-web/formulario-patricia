# URL do projeto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "Publishable key" (sb_publishable_...) ou a antiga "anon key".
# É segura no navegador: ela só consegue executar public.solicitar_vaga().
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
